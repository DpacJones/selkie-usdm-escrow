# Selkie runs against Midnight Preview.
NETWORK=testnet

# Midnight wallet mnemonic (server/CLI side only).
# Use a TESTNET-ONLY throwaway phrase .. never a wallet that holds real funds.
MIDNIGHT_MNEMONIC_PREVIEW="word1 word2 ... word24"

# Local Midnight proof server .. required for creating/claiming escrows.
# docker run -d -p 6300:6300 midnightntwrk/proof-server:8.0.3
# PROOF_SERVER_URL=http://localhost:6300

# Set after `node selkie.mjs deploy`:
# SELKIE_CONTRACT_ADDRESS=0200...
